{
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "web",
            "ports": [
              {
                "containerPort": 80,
                "name": "http",
                "protocol": "TCP"
              },
              {
                "containerPort": 443,
                "name": "https",
                "protocol": "TCP"
              }
            ],
            "volumeMounts": [
              {
                "name": "app-code",
                "mountPath": "/var/www/html"
              },
              {
                "name": "nginx-config",
                "mountPath": "/etc/nginx/conf.d/default.conf",
                "subPath": "default.conf"
              },
              {
                "name": "event-booking-tls",
                "mountPath": "/etc/nginx/tls",
                "readOnly": true
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "app-code",
            "emptyDir": {}
          },
          {
            "name": "nginx-config",
            "configMap": {
              "name": "event-booking-nginx"
            }
          },
          {
            "name": "event-booking-tls",
            "secret": {
              "secretName": "event-booking-backend-tls"
            }
          }
        ]
      }
    }
  }
}
